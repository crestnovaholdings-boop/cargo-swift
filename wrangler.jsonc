{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "cargo-swift",

  "main": "dist/server/server.js",

  "compatibility_date": "2026-06-06",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}
